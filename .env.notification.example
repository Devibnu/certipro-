# ==================================
# NOTIFICATION CONFIGURATION
# ==================================

# Email Configuration (already exists in Laravel)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@lsp-certipro.id
MAIL_FROM_NAME="LSP CertiPro"

# Admin email for failure alerts
NOTIFICATION_ADMIN_EMAIL=admin@lsp-certipro.id

# WhatsApp Configuration
# Provider options: fonnte, wablas, twilio, meta
WHATSAPP_PROVIDER=fonnte

# Fonnte (Recommended for Indonesia)
# Register at: https://fonnte.com
FONNTE_API_KEY=your-fonnte-api-key-here
FONNTE_API_URL=https://api.fonnte.com

# Alternative: Wablas
# WABLAS_API_KEY=your-wablas-api-key
# WABLAS_API_URL=https://wablas.com

# Alternative: Twilio WhatsApp
# TWILIO_ACCOUNT_SID=ACxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Alternative: Meta WhatsApp Business API
# META_WHATSAPP_PHONE_ID=your-phone-id
# META_WHATSAPP_ACCESS_TOKEN=your-access-token

# Queue Configuration (CRITICAL for async notifications)
QUEUE_CONNECTION=database
# Alternative: QUEUE_CONNECTION=redis (for production)

# Redis Configuration (if using redis queue)
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
